X_test, y_test = window_data(test_touches, test_gestures_numeric, window_size, stride_size)

num_classes = 7


class CNN_Netwrok(nn.Module):
    def __init__(self):
        super(CNN_Netwrok, self).__init__()
        self.conv1 = nn.Conv2d(in_channels=window_size, out_channels=64, kernel_size=3, padding=1)
        self.bn1 = nn.BatchNorm2d(64)
        self.conv2 = nn.Conv2d(in_channels=64, out_channels=128, kernel_size=3, padding=1)
        self.bn2 = nn.BatchNorm2d(128)
        self.conv3 = nn.Conv2d(in_channels=128, out_channels=256, kernel_size=3, padding=1)
        self.bn3 = nn.BatchNorm2d(256)
        self.conv4 = nn.Conv2d(in_channels=256, out_channels=512, kernel_size=3, padding=1)
        self.bn4 = nn.BatchNorm2d(512)
        self.fc1 = nn.Linear(in_features=512*2*2, out_features=256)

        self.dropout = nn.Dropout(0.5)
        self.fc2 = nn.Linear(in_features=256, out_features=32)

    def forward(self, x):
        # print(f"Input shape: {x.shape}")
        x = self.conv1(x)
        x = self.bn1(x)
        x = F.relu(x)
        # print(f"After conv1: {x.shape}")
        x = self.conv2(x)
        x = self.bn2(x)
        x = F.relu(x)
        # print(f"After conv2: {x.shape}")
        x = F.max_pool2d(x, 2)
        # print(f"After max_pool2d: {x.shape}")
        x = self.conv3(x)
        x = self.bn3(x)
        x = F.relu(x)

        x = self.conv4(x)
        x = self.bn4(x)
        x = F.relu(x)

        x = F.max_pool2d(x, 2)

        x = torch.flatten(x, 1)
        # print(f"After flatten: {x.shape}")
        x = self.fc1(x)
        # print(f"After fc1: {x.shape}")
        x = F.relu(x)
        x = self.dropout(x)
        x = self.fc2(x)
        return x

class CNN_Transformer_Network(nn.Module):
    def __init__(self, num_classes=num_classes, num_transformer_layers=2, d_model= 32, num_heads=4, dim_feedforward=128, dropout=0.5, timesteps=1):
        super(CNN_Transformer_Network, self).__init__()
        self.cnn = CNN_Netwrok()
        self.position_encoding = nn.Parameter(torch.zeros(1, timesteps, d_model))
        self.transformer_encoder_layer = nn.TransformerEncoderLayer(d_model=d_model, nhead=num_heads,
                                                                    dim_feedforward=dim_feedforward, dropout=dropout)
        self.transformer_encoder = nn.TransformerEncoder(self.transformer_encoder_layer,
                                                         num_layers=num_transformer_layers)
        self.fc = nn.Linear(d_model, num_classes)

    def forward(self, x):
        batch_size, Channels, H, W = x.size()
        # x = x.view(batch_size * timesteps, 1, H, W)
        timesteps = 1
        x = self.cnn(x)
        x = x.view(batch_size, timesteps, -1)
        x += self.position_encoding[:, :timesteps, :]
        x = x.permute(1, 0, 2)
        x = self.transformer_encoder(x)
        x = x.permute(1, 0, 2)
        out = self.fc(x[:, -1, :])
        output = F.log_softmax(out, dim=1)
        return output
